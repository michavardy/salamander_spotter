# Salamander Spotter — every SPOTTER_* var (spec §2.4, §4.3). Copy to .env.

# --- bind / exposure -------------------------------------------------------
SPOTTER_HOST=0.0.0.0
SPOTTER_PORT=8756
# Absolute URL reviewers use; leave blank for same-origin behind a proxy.
SPOTTER_EXTERNAL_BASE_URL=https://spotter.example.org
# Optional "who's reviewing" label default (spec §1.3).
SPOTTER_ACTOR_LABEL=
# Expose the OpenAPI docs at /api/docs (default off).
SPOTTER_EXPOSE_API_DOCS=false

# --- data dir (container: the mounted volume) ---------------------------
SPOTTER_DATA_DIR=/data

# --- secrets (also settable in-app; stored in /data/secrets.json 0600) ---
SPOTTER_LLM_API_KEY=
SPOTTER_JUDGE_API_KEY=
SPOTTER_SMTP_PASSWORD=
SPOTTER_MAP_TILE_KEY=

# --- backup sidecar ------------------------------------------------------
SPOTTER_BACKUP_DIR=./backups
