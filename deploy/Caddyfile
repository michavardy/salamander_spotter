# spec §2.1 — TLS termination for the single instance.
# Bare-IP mode: no domain yet, so plain HTTP on :80 (Let's Encrypt can't issue
# certs for IPs). Once you have a domain pointed at this droplet, replace the
# ":80" block below with "yourdomain.example {" so Caddy auto-provisions TLS
# and proxies :443 -> the app container.

:80 {
	encode zstd gzip
	reverse_proxy app:8756 {
		header_up X-Forwarded-Proto {scheme}
		header_up Host {host}
	}

	# Cloudflare Access / basic-auth can be layered here if the edge is Caddy.
	# The app itself has no login in v1 (spec §1.3).
}
